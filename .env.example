# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-secure-random-secret-key
PORT=5000

# Storage Configuration
# Default is system temp directory (outside project tree)
# For Render Free, use a writable path e.g. /tmp/obsidian_storage
# STORAGE_DIR=/tmp/obsidian_storage

# Storage and Resource Limits (Bytes/Counts)
# MAX_FILE_SIZE=26214400        # 25 MB per file (default)
# MAX_COLLECTION_SIZE=52428800  # 50 MB per collection (default)
# MAX_FILE_COUNT=10             # 10 files per collection (default)
# MAX_TOTAL_STORAGE=262144000   # 250 MB total ephemeral storage quota (default)
